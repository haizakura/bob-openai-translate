{
  "identifier": "com.haizakura.bob.openai.translate",
  "version": "0.1.1",
  "category": "translate",
  "icon": "124",
  "author": "haizakura",
  "homepage": "https://github.com/haizakura/bob-openai-translate",
  "minBobVersion": "1.8.0",
  "options": [
    {
      "identifier": "mode",
      "type": "menu",
      "defaultValue": "translate",
      "isKeyOption": true,
      "menuValues": [
        { "value": "translate" },
        { "value": "polish" },
        { "value": "custom" }
      ]
    },
    {
      "identifier": "apiKey",
      "type": "text",
      "textConfig": {
        "type": "secure"
      }
    },
    {
      "identifier": "baseURL",
      "type": "text",
      "defaultValue": "https://api.openai.com",
      "textConfig": {
        "type": "visible"
      }
    },
    {
      "identifier": "apiPath",
      "type": "text",
      "defaultValue": "/v1/responses",
      "textConfig": {
        "type": "visible"
      }
    },
    {
      "identifier": "model",
      "type": "menu",
      "defaultValue": "gpt-5.6-luna",
      "menuValues": [
        { "value": "gpt-5.6-luna" },
        { "value": "gpt-5.6-terra" },
        { "value": "gpt-5.6-sol" },
        { "value": "custom" }
      ]
    },
    {
      "identifier": "customModel",
      "type": "text",
      "textConfig": {
        "type": "visible"
      }
    },
    {
      "identifier": "reasoningEffort",
      "type": "menu",
      "defaultValue": "none",
      "menuValues": [
        { "value": "auto" },
        { "value": "none" },
        { "value": "minimal" },
        { "value": "low" },
        { "value": "medium" },
        { "value": "high" },
        { "value": "xhigh" },
        { "value": "max" }
      ]
    },
    {
      "identifier": "verbosity",
      "type": "menu",
      "defaultValue": "auto",
      "menuValues": [
        { "value": "auto" },
        { "value": "low" },
        { "value": "medium" },
        { "value": "high" }
      ]
    },
    {
      "identifier": "maxOutputTokens",
      "type": "text",
      "defaultValue": "4096",
      "textConfig": {
        "type": "visible"
      }
    },
    {
      "identifier": "stream",
      "type": "menu",
      "defaultValue": "enabled",
      "menuValues": [
        { "value": "enabled" },
        { "value": "disabled" }
      ]
    },
    {
      "identifier": "requestTimeout",
      "type": "menu",
      "defaultValue": "60",
      "menuValues": [
        { "value": "30" },
        { "value": "60" },
        { "value": "120" },
        { "value": "180" },
        { "value": "300" }
      ]
    },
    {
      "identifier": "systemPrompt",
      "type": "text",
      "textConfig": {
        "type": "visible",
        "height": 100,
        "keyWords": [
          "$query.text",
          "$query.detectFromLang",
          "$query.detectToLang"
        ]
      }
    },
    {
      "identifier": "userPrompt",
      "type": "text",
      "defaultValue": "$query.text",
      "textConfig": {
        "type": "visible",
        "height": 100,
        "keyWords": [
          "$query.text",
          "$query.detectFromLang",
          "$query.detectToLang"
        ]
      }
    }
  ]
}
