{
  "name": "bob-openai-translate",
  "version": "0.1.1",
  "description": "OpenAI translation, polishing, and custom-prompt plugin for Bob",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:zh": "node scripts/build.mjs --locale zh-Hans",
    "build:en": "node scripts/build.mjs --locale en",
    "build:all": "node scripts/build.mjs --locale all",
    "appcast": "node scripts/appcast.mjs",
    "release:prepare": "npm run build:all && npm run appcast",
    "check": "node scripts/check.mjs",
    "test": "node --test"
  },
  "license": "MIT"
}
